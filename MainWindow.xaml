<Window x:Class="UltraIDevice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultra iDevice"
        Width="720" Height="760"
        MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource MainWindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        Closing="Window_Closing">

    <DockPanel>
        <!-- Meni — tekstovi se postavljaju iz ApplyLanguage() -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource PanelBg2}" Foreground="{DynamicResource TextPrimary}"
              x:Name="mnuMain">
            <MenuItem x:Name="mnuFileRoot" Header="_File">
                <MenuItem x:Name="mnuExit" Header="E_xit" InputGestureText="Alt+F4" Click="MnuExit_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuViewRoot" Header="_View">
                <MenuItem x:Name="mnuThemeRoot" Header="Theme">
                    <MenuItem x:Name="mnuThemeDark" Header="_Dark (default)" IsCheckable="True" Click="ThemeMenuItem_Click" Tag="dark"/>
                    <MenuItem x:Name="mnuThemeLight" Header="_Light" IsCheckable="True" Click="ThemeMenuItem_Click" Tag="light"/>
                    <MenuItem x:Name="mnuThemeContrast" Header="_High contrast" IsCheckable="True" Click="ThemeMenuItem_Click" Tag="contrast"/>
                </MenuItem>
                <MenuItem x:Name="mnuTextSizeRoot" Header="Text size">
                    <MenuItem x:Name="mnuLarger" Header="_Larger text" InputGestureText="Ctrl++" Click="LargerText_Click"/>
                    <MenuItem x:Name="mnuSmaller" Header="_Smaller text" InputGestureText="Ctrl+-" Click="SmallerText_Click"/>
                    <MenuItem x:Name="mnuReset" Header="_Reset text size" InputGestureText="Ctrl+0" Click="ResetText_Click"/>
                </MenuItem>
                <MenuItem x:Name="mnuLanguageRoot" Header="_Language">
                    <MenuItem x:Name="mnuLangEn" Header="_English" IsCheckable="True" Click="LanguageMenuItem_Click" Tag="en"/>
                    <MenuItem x:Name="mnuLangSr" Header="_Serbian (Srpski)" IsCheckable="True" Click="LanguageMenuItem_Click" Tag="sr"/>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="mnuToolsRoot" Header="_Tools">
                <MenuItem x:Name="mnuInstallTools" Header="_Install / update device tools..." Click="MnuInstallTools_Click"/>
                <MenuItem x:Name="mnuCheckDriver" Header="_Check Apple driver" Click="MnuCheckDriver_Click"/>
                <MenuItem x:Name="mnuOpenLogs" Header="_Open logs folder" Click="MnuOpenLogs_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuSpeakProgress" Header="_Speak progress out loud" IsCheckable="True" Click="MnuSpeakProgress_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuHelpRoot" Header="_Help">
                <MenuItem x:Name="mnuShortcuts" Header="_Keyboard shortcuts" InputGestureText="F1" Click="MnuShortcuts_Click"/>
                <MenuItem x:Name="mnuErrorCodes" Header="_Error code explanations" Click="MnuErrorCodes_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuSupport" Header="How to _support this project" Click="MnuSupport_Click"/>
                <MenuItem x:Name="mnuAbout" Header="_About" Click="MnuAbout_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="20,14,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 naslov -->
                <RowDefinition Height="Auto"/>  <!-- 1 uređaj -->
                <RowDefinition Height="Auto"/>  <!-- 2 firmver -->
                <RowDefinition Height="*"/>     <!-- 3 radnje -->
                <RowDefinition Height="Auto"/>  <!-- 4 napredak -->
                <RowDefinition Height="Auto"/>  <!-- 5 verzija -->
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="txbAppTitle" Text="Ultra iDevice"
                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Name="txbAppSubtitle" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- UREĐAJ -->
            <GroupBox Grid.Row="1" x:Name="grpDevice" Header="Device" Margin="0,0,0,10">
                <Grid Margin="8,6,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label x:Name="lblDeviceStatus" Content="Connected device:" Padding="0,0,0,3"/>
                        <TextBlock x:Name="txbDeviceStatus" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}" FontSize="13"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Button x:Name="btnRefresh" Grid.Column="2" Content="Refresh" VerticalAlignment="Bottom"
                            Click="BtnRefresh_Click"/>
                </Grid>
            </GroupBox>

            <!-- FIRMVER -->
            <GroupBox Grid.Row="2" x:Name="grpFirmware" Header="Firmware (iOS) source" Margin="0,0,0,10">
                <StackPanel Margin="8,6,8,8">
                    <RadioButton x:Name="rbLatest" GroupName="Firmware" Content="Latest signed iOS" IsChecked="True"
                                 Checked="Firmware_Changed"/>
                    <RadioButton x:Name="rbIpsw" GroupName="Firmware" Content="Use an IPSW file I already have"
                                 Checked="Firmware_Changed"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="lblIpswPath" Grid.Column="0" Content="IPSW file:" VerticalAlignment="Center"
                               Target="{Binding ElementName=txtIpswPath}"/>
                        <TextBox x:Name="txtIpswPath" Grid.Column="2" IsReadOnly="True" VerticalAlignment="Center"/>
                        <Button x:Name="btnBrowseIpsw" Grid.Column="4" Content="Browse..." Click="BtnBrowseIpsw_Click"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- RADNJE -->
            <GroupBox Grid.Row="3" x:Name="grpActions" Header="Actions">
                <WrapPanel Margin="8,8,8,8">
                    <Button x:Name="btnInfo" Content="Device information" Margin="0,0,8,8" Click="BtnInfo_Click"/>
                    <Button x:Name="btnUpdate" Content="Update iOS" Margin="0,0,8,8" Style="{StaticResource PrimaryBtn}" Click="BtnUpdate_Click"/>
                    <Button x:Name="btnRestore" Content="Restore iOS (erases)..." Margin="0,0,8,8" Click="BtnRestore_Click"/>
                    <Button x:Name="btnBackup" Content="Back up..." Margin="0,0,8,8" Click="BtnBackup_Click"/>
                    <Button x:Name="btnRestoreBackup" Content="Restore from backup..." Margin="0,0,8,8" Click="BtnRestoreBackup_Click"/>
                    <Button x:Name="btnRecovery" Content="Enter recovery" Margin="0,0,8,8" Click="BtnRecovery_Click"/>
                    <Button x:Name="btnExitRecovery" Content="Exit recovery / DFU" Margin="0,0,8,8" Click="BtnExitRecovery_Click"/>
                    <Button x:Name="btnDfu" Content="Guided DFU mode..." Margin="0,0,8,8" Click="BtnDfu_Click"/>
                </WrapPanel>
            </GroupBox>

            <!-- NAPREDAK -->
            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="prgOverall" Grid.Column="0" Height="12" Minimum="0" Maximum="100" Value="0"
                                 Background="{DynamicResource ControlBg}" Foreground="#0078D4" VerticalAlignment="Center"/>
                    <Button x:Name="btnCancel" Grid.Column="2" Content="Cancel" IsEnabled="False" Click="BtnCancel_Click"/>
                </Grid>
                <TextBlock x:Name="txbProgress" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,5,0,0"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
            </StackPanel>

            <TextBlock Grid.Row="5" x:Name="txbAppStatus" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Right" Margin="0,6,0,0"/>
        </Grid>
    </DockPanel>
</Window>
