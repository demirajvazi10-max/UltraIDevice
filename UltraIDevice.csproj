<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyName>UltraIDevice</AssemblyName>
		<RootNamespace>UltraIDevice</RootNamespace>
		<!-- Isto mesto kao u ostalim Ultra .csproj fajlovima — jedino koje treba
		     promeniti pre svakog GitHub release-a/tag-a. MainWindow.xaml.cs ->
		     GetAppVersion() čita ovu vrednost u runtime-u za naslov i About. -->
		<Version>1.0.0</Version>
		<Authors>Demir Ajvazi</Authors>
		<Company>Demir Ajvazi</Company>
		<Product>Ultra iDevice</Product>
		<Copyright>© Demir Ajvazi</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<!-- UseWindowsForms (samo zbog FolderBrowserDialog-a) bi inače dodao globalne
		     "using System.Windows.Forms/System.Drawing" u svaki fajl, pa bi Button,
		     TextBox, Label, ComboBox... bili dvosmisleni sa WPF-ovim. WinForms se
		     koristi samo preko aliasa WinForms u code-behind fajlovima. -->
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>

	<!-- Ako u korenu projekta postoji folder "tools" (libimobiledevice/idevicerestore
	     .exe i .dll), kopiraj ga pored exe-ja pri svakom build-u. Tako kad pokreneš iz
	     Visual Studija, aplikacija nalazi alate bez ikakve instalacije. Folder "tools"
	     je u .gitignore, pa binarni fajlovi NE idu u git — stoje samo lokalno kod tebe.
	     Ako folder ne postoji, ovo se tiho preskače. -->
	<ItemGroup>
		<None Include="tools\**\*" Condition="Exists('tools')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>tools\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</None>
	</ItemGroup>

</Project>
