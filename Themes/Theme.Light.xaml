<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="MainWindowBg" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="WindowBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBg2" Color="#ECECEC"/>
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#111111"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#555555"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>

    <!-- Accents / actions -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0A7D32"/>
    <SolidColorBrush x:Key="ApplyBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="CancelBrush" Color="#B71C1C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#C76A00"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#4A148C"/>

    <!-- Structure -->
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#CCCCCC"/>

</ResourceDictionary>
